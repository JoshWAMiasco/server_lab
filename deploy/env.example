# ServerLab configuration.
# Production copy: /etc/serverlab/serverlab.env (mode 640, root:serverlab). install.sh creates it
# from this file and fills in SESSION_SECRET. After editing it, restart both units:
#   sudo systemctl restart serverlab-collector serverlab-web
#
# The file is read by systemd (EnvironmentFile=) and sourced by the `serverlab` CLI wrapper, so:
# one KEY=value per line, no spaces around "=", no `export`, quote values that contain spaces.

# --- Core --------------------------------------------------------------------

# SQLite database. Must stay inside /var/lib/serverlab (the only writable path for the units).
DATABASE_PATH=/var/lib/serverlab/serverlab.db

# linux = read the real host. mock = fake data (development on macOS).
COLLECTOR_DRIVER=linux

# How often the collector takes a sample, in milliseconds.
SAMPLE_INTERVAL_MS=2000

# --- Network and links -------------------------------------------------------

# Tailscale MagicDNS name used for Lobby "Open" links, e.g. homelab.tail1234.ts.net.
# Optional: auto-detected from `tailscale status` when empty.
PUBLIC_HOSTNAME=

# --- Authentication ----------------------------------------------------------

# Random secret for session cookies. install.sh generates it with `openssl rand -base64 32`.
# Changing it logs everyone out.
SESSION_SECRET=

# One-time token that /setup asks for. install.sh writes it; the app deletes it after setup.
SETUP_TOKEN_PATH=/var/lib/serverlab/setup-token

# Session cookie gets the Secure flag. Set to false ONLY for plain-http testing on localhost.
COOKIE_SECURE=true

# --- Host integration --------------------------------------------------------

# DB-IP City Lite database (offline login geolocation). Refreshed monthly by
# serverlab-geoip-update.timer. Must stay inside /var/lib/serverlab.
GEOIP_DB_PATH=/var/lib/serverlab/dbip-city-lite.mmdb

# nginx entry config. The Lobby follows its `include`s to list hosted sites and ports.
NGINX_CONFIG_PATH=/etc/nginx/nginx.conf

# Tailscale certificate served by nginx. The "TLS cert expiring" alert reads its expiry date.
TLS_CERT_PATH=/etc/nginx/tls/ts.crt

# --- Notifications (all optional; empty = channel not configured) -------------

# ntfy topic URL, e.g. https://ntfy.sh/my-long-random-topic or your self-hosted server.
NTFY_URL=
# Access token for a protected ntfy topic.
NTFY_TOKEN=

# Discord channel webhook URL (Channel settings > Integrations > Webhooks).
DISCORD_WEBHOOK_URL=

# Telegram bot token from @BotFather, and the chat id to send to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
