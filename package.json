{
  "name": "server-lab",
  "version": "1.1.0",
  "private": true,
  "description": "ServerLab: a small, Grafana-like dashboard for one homelab server, with firewall and fail2ban pages that teach the CLI.",
  "license": "MIT",
  "author": "Joshua Miasco",
  "homepage": "https://github.com/JoshWAMiasco/server_lab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoshWAMiasco/server_lab.git"
  },
  "bugs": {
    "url": "https://github.com/JoshWAMiasco/server_lab/issues"
  },
  "scripts": {
    "dev": "concurrently -k -n web,collector -c red,yellow \"npm:dev:web\" \"npm:dev:collector\"",
    "dev:web": "next dev",
    "dev:collector": "tsx watch --env-file-if-exists=.env.local collector/index.ts",
    "build": "next build && npm run build:collector",
    "build:collector": "tsup",
    "start": "next start -H 127.0.0.1 -p 3000",
    "start:collector": "node dist/collector/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "serverlab": "tsx scripts/serverlab-cli.ts",
    "lint": "eslint .",
    "type-check": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@headlessui/react": "2.2.10",
    "@hookform/resolvers": "5.9.2",
    "@node-rs/argon2": "2.2.2",
    "@tanstack/react-table": "8.21.3",
    "better-sqlite3": "13.0.3",
    "chart.js": "4.5.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.61.0",
    "maxmind": "5.0.7",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "simplebar-react": "3.3.2",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-jsdoc": "63.3.3",
    "eslint-plugin-unicorn": "65.0.1",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
